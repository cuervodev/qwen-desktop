{
  "name": "qwen-desktop",
  "version": "1.0.1",
  "description": "Qwen AI Desktop App - Access chat.qwen.ai directly from your desktop with persistent sessions",
  "main": "main.js",
  "author": "Qwen Desktop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.qwen.desktop",
    "productName": "Qwen Desktop",
    "icon": "assets/icon.png",
    "publish": {
      "provider": "github",
      "owner": "cuervodev",
      "repo": "qwen-desktop"
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@34.5.8": true
  }
}
